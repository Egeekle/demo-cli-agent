  "cards": [
    {
      "dot": "rose",
      "title": "Human-in-the-loop safety",
      "items": [
        "create, update and delete are registered with requires_approval=True",
        "The run halts and returns DeferredToolRequests; the tool body never executes until approved",
        "check_availability blocks double-booking with ModelRetry before any write"
      ]
    },
    {
      "dot": "emerald",
      "title": "One shared model",
      "items": [
        "src/providers.py builds a single OpenAIResponsesModel on one OpenAIProvider",
        "Both appointment_agent and negotiator_agent import agent_model from it",
        "mlflow.pydantic_ai.autolog() is called once, at import time"
      ]
    },
    {
      "dot": "violet",
      "title": "Dependency injection",
      "items": [
        "Deps carries the AsyncSession, the negotiator agent and a now() clock",
        "One session per user turn, opened in _run_turn and reused across the approval round-trip"
      ]
    },
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "appointment-agent runs the Typer chat loop in src/main.py",
        "ml-ui shells out to mlflow server against the same tracking URI"
      ]
    }
  ]
